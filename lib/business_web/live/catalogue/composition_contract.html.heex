<section class="catalogue-binding-section" id={"contract-#{@contract["component"]}"}>
  <h3>Composition contract</h3>
  <p>{@contract["purpose"]}</p>
  <.link
    patch={"/dev/catalogue/model?node=#{@contract["interaction"]}"}
    class="catalogue-relation"
  >Supports: {Business.Catalogue.Model.get(@contract["interaction"])["name"]}</.link>
  <dl class="catalogue-binding-facts">
    <div :for={key <- ~w(inputs regions state outputs variants recovery gaps)}>
      <dt>{Business.Catalogue.Model.label(key)}</dt><dd>
        {Business.Catalogue.Model.describe(@contract[key])}
      </dd>
    </div>
  </dl>
</section>
