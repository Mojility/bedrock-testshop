<section
  class="catalogue-panel catalogue-space"
  aria-label={Shop.Catalogue.Components.get(@mode).title}
>
  <%= case @mode do %>
    <% "website-intro" -> %>
      <span class="catalogue-label">Public website · prospective customer</span>
      <h3>Electrical help for your home or workplace</h3>
      <p>Northline Electrical · fictional business</p>
      <p>
        Repairs, lighting upgrades and electrical inspections. Tell us what you need and our office will arrange the next step.
      </p>
      <ul>
        <li>Repairs and troubleshooting</li><li>Lighting and EV charging</li><li>
          Commercial inspections
        </li>
      </ul>
      <.link
        patch="/dev/catalogue/model?node=journey:enquiry_to_follow_up#enquiry-demo-form"
        class="wb-button"
      >Request electrical service</.link>
    <% "enquiry-form" -> %>
      <span class="catalogue-label">Public website · prospective customer</span>
      <h3>How can we help?</h3>
      <p id="enquiry-demo-help">
        Sample only. Leave a name and either a phone number or email. Nothing is sent or stored.
      </p>
      <.form
        for={@state.form}
        id="enquiry-demo-form"
        phx-submit="submit_enquiry"
        aria-describedby="enquiry-demo-help"
        novalidate
      >
        <.input
          field={@state.form[:name]}
          label="Your name"
          autocomplete="name"
          required
          class="wb-input"
        />
        <.input
          field={@state.form[:phone]}
          type="tel"
          label="Phone (or email below)"
          autocomplete="tel"
          class="wb-input"
        />
        <.input
          field={@state.form[:email]}
          type="email"
          label="Email (or phone above)"
          autocomplete="email"
          class="wb-input"
        />
        <.input
          field={@state.form[:message]}
          type="textarea"
          label="What do you need help with?"
          class="wb-input"
        />
        <.button type="submit" class="wb-button">Send sample enquiry</.button>
      </.form>
      <p :if={@state.result} role="status" class="catalogue-space">{@state.result}</p>
    <% "lead-queue" -> %>
      <span class="catalogue-label">Staff workspace · office staff</span>
      <h3>Enquiries to follow up</h3>
      <p>
        In the customer system, this stage requires staff sign-in. This catalogue shows both Actors’ views to explain the handoff.
      </p>
      <p role="status">
        {length(@state.leads)} sample enquiries · selected: {@state.selected.name}
      </p>
      <Workbench.data_table
        id="enquiry-queue"
        rows={@state.leads}
        row_id={& &1.id}
        selected_id={@state.selected.id}
        row_click="select_enquiry"
        caption="Website enquiries — select a row to review its follow-up"
      >
        <:col :let={lead} label="Customer">
          <button
            type="button"
            class="wb-link wb-row-select"
            phx-click="select_enquiry"
            phx-value-id={lead.id}
            aria-pressed={to_string(lead.id == @state.selected.id)}
            aria-label={"Review enquiry from #{lead.name}"}
          >{lead.name}</button>
          <small>{lead.email || lead.phone}</small>
        </:col>
        <:col :let={lead} label="Request">{lead.message}</:col>
        <:col :let={lead} label="Received">
          <time datetime={DateTime.to_iso8601(lead.inserted_at)}>{Calendar.strftime(
            lead.inserted_at,
            "%b %d, %H:%M UTC"
          )}</time>
        </:col>
        <:col :let={lead} label="Status">
          <Workbench.status label={String.capitalize(lead.status)} />
        </:col>
      </Workbench.data_table>
    <% "lead-follow-up" -> %>
      <span class="catalogue-label">Staff workspace · office staff</span>
      <h3>Follow up with {@state.selected.name}</h3>
      <div class="catalogue-grid flush">
        <section aria-label="Original enquiry">
          <h4>Original enquiry</h4>
          <p>{@state.selected.message}</p>
          <dl class="wb-facts">
            <div>
              <dt>Email</dt><dd>{@state.selected.email || "Not provided"}</dd>
            </div>
            <div>
              <dt>Phone</dt><dd>{@state.selected.phone || "Not provided"}</dd>
            </div>
            <div>
              <dt>Source</dt><dd>Public website</dd>
            </div>
          </dl>
        </section>
        <.form
          for={@state.follow_up}
          id="lead-follow-up-form"
          phx-submit="save_enquiry_follow_up"
          aria-describedby="follow-up-help"
          novalidate
        >
          <p id="follow-up-help">
            Private staff record. Contact the customer separately; changing status does not send a reply.
          </p>
          <.input
            field={@state.follow_up[:status]}
            type="select"
            label="Follow-up status"
            options={[{"New", "new"}, {"Contacted", "contacted"}, {"Closed", "closed"}]}
            class="wb-input"
          />
          <.input
            field={@state.follow_up[:notes]}
            type="textarea"
            label="Private follow-up notes"
            class="wb-input"
          />
          <.button type="submit" class="wb-button">Save sample follow-up</.button>
        </.form>
      </div>
      <p :if={@state.saved} role="status" class="catalogue-space">{@state.saved}</p>
  <% end %>
</section>
