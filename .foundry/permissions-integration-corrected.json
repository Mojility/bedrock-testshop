    "service": "set -eu\numask 077\nif test ! -f /workspace/runtime.env; then\n  printf 'export SECRET_KEY_BASE=%s\n' \"$(openssl rand -hex 64)\" > /workspace/runtime.env\nfi\nprintf '%s\n' 'export CUSTOMER_EXPLORATION=true' 'export EXPLORATION_PARENT_ORIGIN=https://owner-proof.mybedrock.ca' 'export EXPLORATION_PLATFORM_ORIGIN=https://mybedrock.ca' 'export EXPLORATION_MEDIA_ORIGIN=https://owner-proof-media.mybedrock.ca' >> /workspace/runtime.env\n. /workspace/runtime.env\nexec env MIX_HOME=/workspace/app/.bedrock-tools/mix HEX_HOME=/workspace/app/.bedrock-tools/hex MIX_ENV=prod PHX_SERVER=true PORT=4000 mix phx.server\n",
